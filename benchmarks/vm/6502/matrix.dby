import "../../../runtime/v12.1.0/alloc.dby" as alloc
import "../../../runtime/v12.1.0/array.dby" as arrays
import "../../../runtime/v12.1.0/hosted_alloc.dby" as host
import "core.dby" as nmos

fn is_expected_legal(opcode: u8) -> bool:
    let legal: array[u8, 151] = [0x00 as u8, 0x01 as u8, 0x05 as u8, 0x06 as u8, 0x08 as u8, 0x09 as u8, 0x0a as u8, 0x0d as u8, 0x0e as u8, 0x10 as u8, 0x11 as u8, 0x15 as u8, 0x16 as u8, 0x18 as u8, 0x19 as u8, 0x1d as u8, 0x1e as u8, 0x20 as u8, 0x21 as u8, 0x24 as u8, 0x25 as u8, 0x26 as u8, 0x28 as u8, 0x29 as u8, 0x2a as u8, 0x2c as u8, 0x2d as u8, 0x2e as u8, 0x30 as u8, 0x31 as u8, 0x35 as u8, 0x36 as u8, 0x38 as u8, 0x39 as u8, 0x3d as u8, 0x3e as u8, 0x40 as u8, 0x41 as u8, 0x45 as u8, 0x46 as u8, 0x48 as u8, 0x49 as u8, 0x4a as u8, 0x4c as u8, 0x4d as u8, 0x4e as u8, 0x50 as u8, 0x51 as u8, 0x55 as u8, 0x56 as u8, 0x58 as u8, 0x59 as u8, 0x5d as u8, 0x5e as u8, 0x60 as u8, 0x61 as u8, 0x65 as u8, 0x66 as u8, 0x68 as u8, 0x69 as u8, 0x6a as u8, 0x6c as u8, 0x6d as u8, 0x6e as u8, 0x70 as u8, 0x71 as u8, 0x75 as u8, 0x76 as u8, 0x78 as u8, 0x79 as u8, 0x7d as u8, 0x7e as u8, 0x81 as u8, 0x84 as u8, 0x85 as u8, 0x86 as u8, 0x88 as u8, 0x8a as u8, 0x8c as u8, 0x8d as u8, 0x8e as u8, 0x90 as u8, 0x91 as u8, 0x94 as u8, 0x95 as u8, 0x96 as u8, 0x98 as u8, 0x99 as u8, 0x9a as u8, 0x9d as u8, 0xa0 as u8, 0xa1 as u8, 0xa2 as u8, 0xa4 as u8, 0xa5 as u8, 0xa6 as u8, 0xa8 as u8, 0xa9 as u8, 0xaa as u8, 0xac as u8, 0xad as u8, 0xae as u8, 0xb0 as u8, 0xb1 as u8, 0xb4 as u8, 0xb5 as u8, 0xb6 as u8, 0xb8 as u8, 0xb9 as u8, 0xba as u8, 0xbc as u8, 0xbd as u8, 0xbe as u8, 0xc0 as u8, 0xc1 as u8, 0xc4 as u8, 0xc5 as u8, 0xc6 as u8, 0xc8 as u8, 0xc9 as u8, 0xca as u8, 0xcc as u8, 0xcd as u8, 0xce as u8, 0xd0 as u8, 0xd1 as u8, 0xd5 as u8, 0xd6 as u8, 0xd8 as u8, 0xd9 as u8, 0xdd as u8, 0xde as u8, 0xe0 as u8, 0xe1 as u8, 0xe4 as u8, 0xe5 as u8, 0xe6 as u8, 0xe8 as u8, 0xe9 as u8, 0xea as u8, 0xec as u8, 0xed as u8, 0xee as u8, 0xf0 as u8, 0xf1 as u8, 0xf5 as u8, 0xf6 as u8, 0xf8 as u8, 0xf9 as u8, 0xfd as u8, 0xfe as u8]
    let index: usize = 0 as usize
    while index < (151 as usize):
        if legal[index] == opcode:
            return true
        index = index + (1 as usize)
    return false

fn run_matrix() -> Result[usize, alloc.AllocError]:
    let memory = arrays.with_capacity[u8](65536 as usize, host.system_allocator())?
    let fill: usize = 0 as usize
    while fill < (65536 as usize):
        arrays.push[u8](borrow mut memory, 0 as u8)?
        fill = fill + (1 as usize)
    let view = arrays.as_mut_slice[u8](borrow mut memory)
    let opcode: usize = 0 as usize
    let implemented: usize = 0 as usize
    let mismatches: usize = 0 as usize
    while opcode < (256 as usize):
        view[512 as usize] = opcode as u8
        view[513 as usize] = 0 as u8
        view[514 as usize] = 0 as u8
        view[65534 as usize] = 0 as u8
        view[65535 as usize] = 2 as u8
        let cpu = nmos.initialize(512 as u16)
        let accepted: bool = nmos.step(borrow mut cpu, view)
        if accepted:
            implemented = implemented + (1 as usize)
        if accepted != is_expected_legal(opcode as u8):
            print(opcode)
            mismatches = mismatches + (1 as usize)
        opcode = opcode + (1 as usize)
    print(151)
    print(implemented)
    return Result[usize, alloc.AllocError].Ok(mismatches)

let result = run_matrix()
match result:
    case Result.Ok(mismatches):
        print(mismatches)
    case Result.Err(error):
        print(999)
