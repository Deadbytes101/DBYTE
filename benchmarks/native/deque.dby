import "../../runtime/v12.2.0/linux_system_allocator.dby" as platform
import "../../runtime/v12.3.0/deque.dby" as deques

pub fn main() -> i64:
    let values = deques.with_allocator[u64](platform.system_allocator())
    let index: u64 = 0 as u64
    while index < (4096 as u64):
        let pushed = deques.push_back[u64](borrow mut values, index)
        match pushed:
            case Result.Err(error):
                return 1 as i64
            case Result.Ok(value):
                index = index + (1 as u64)
    let pass: usize = 0 as usize
    let logical: usize = 0 as usize
    let total: u64 = 0 as u64
    while pass < (2048 as usize):
        logical = 0 as usize
        while logical < (4096 as usize):
            let found = deques.get[u64](borrow values, logical)
            match found:
                case Option.None:
                    return 2 as i64
                case Option.Some(value):
                    total = total + *value
            logical = logical + (1 as usize)
        pass = pass + (1 as usize)
    if total == (17175674880 as u64):
        return 42 as i64
    return 3 as i64
