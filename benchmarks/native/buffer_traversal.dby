import "../../runtime/v12.2.0/linux_system_allocator.dby" as platform
import "../../runtime/v12.3.0/buffer.dby" as buffers

fn initialize(index: usize) -> u64:
    return (index & (255 as usize)) as u64

pub fn main() -> i64:
    let created = buffers.from_fn[u64](4096 as usize, platform.system_allocator(), initialize)
    match created:
        case Result.Err(error):
            return 1 as i64
        case Result.Ok(values):
            let view = buffers.as_slice[u64](borrow values)
            let pass: usize = 0 as usize
            let index: usize = 0 as usize
            let total: u64 = 0 as u64
            while pass < (65536 as usize):
                index = 0 as usize
                while index < len(view):
                    total = total + view[index]
                    index = index + (1 as usize)
                pass = pass + (1 as usize)
            if total == (34225520640 as u64):
                return 42 as i64
            return 2 as i64
