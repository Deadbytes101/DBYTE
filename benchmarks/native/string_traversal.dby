import "../../runtime/v12.1.0/string.dby" as strings
import "../../runtime/v12.2.0/linux_system_allocator.dby" as platform

pub fn main() -> i64:
    let created = strings.from_view("DByteNativePerformance", platform.system_allocator())
    match created:
        case Result.Err(error):
            return 1 as i64
        case Result.Ok(text):
            let view = strings.as_view(borrow text)
            let pass: usize = 0 as usize
            let index: usize = 0 as usize
            let total: u64 = 0 as u64
            while pass < (2000000 as usize):
                index = 0 as usize
                while index < len(view):
                    total = total + (view[index] as u64)
                    index = index + (1 as usize)
                pass = pass + (1 as usize)
            if total == (4450000000 as u64):
                return 42 as i64
            return 2 as i64
