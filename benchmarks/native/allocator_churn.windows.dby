import "../../runtime/v12.1.0/alloc.dby" as alloc
import "../../runtime/v12.2.0/windows_system_allocator.dby" as platform

pub fn main() -> i64:
    let allocator = platform.system_allocator()
    let index: usize = 0 as usize
    let total: u64 = 0 as u64
    while index < (50000 as usize):
        let allocated = alloc.allocate(allocator, 64 as usize, 8 as usize)
        match allocated:
            case Result.Err(error):
                return 1 as i64
            case Result.Ok(pointer):
                pointer[0 as usize] = (index & (255 as usize)) as u8
                total = total + (pointer[0 as usize] as u64)
                alloc.release(allocator, pointer, 64 as usize, 8 as usize)
        index = index + (1 as usize)
    if total == (6367960 as u64):
        return 42 as i64
    return 2 as i64
