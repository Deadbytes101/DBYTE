import "gdt.dby" as gdt

const MAX_BINDINGS: usize = 8 as usize

static mut TASK_IDS: array[usize, 8]
static mut PROCESS_CR3: array[usize, 8]
static mut KERNEL_CR3: usize

pub fn process_context_initialize(kernel_cr3: usize) -> int:
    KERNEL_CR3 = kernel_cr3
    let index: usize = 0 as usize
    while index < MAX_BINDINGS:
        TASK_IDS[index] = 0 as usize
        PROCESS_CR3[index] = 0 as usize
        index = index + (1 as usize)
    return 0

pub fn bind_process_task(task_id: usize, cr3: usize) -> int:
    if task_id == (0 as usize):
        return 1
    if (cr3 & (4095 as usize)) != (0 as usize):
        return 1
    let index: usize = 0 as usize
    while index < MAX_BINDINGS:
        if TASK_IDS[index] == (0 as usize):
            TASK_IDS[index] = task_id
            PROCESS_CR3[index] = cr3
            return 0
        index = index + (1 as usize)
    return 2

pub fn unbind_process_task(task_id: usize) -> usize:
    let index: usize = 0 as usize
    while index < MAX_BINDINGS:
        if TASK_IDS[index] == task_id:
            let result: usize = PROCESS_CR3[index]
            TASK_IDS[index] = 0 as usize
            PROCESS_CR3[index] = 0 as usize
            return result
        index = index + (1 as usize)
    return 0 as usize

pub fn activate_process_task(task_id: usize, kernel_stack_top: usize) -> int:
    let selected: usize = KERNEL_CR3
    let index: usize = 0 as usize
    while index < MAX_BINDINGS:
        if TASK_IDS[index] == task_id:
            selected = PROCESS_CR3[index]
            index = MAX_BINDINGS
        else:
            index = index + (1 as usize)
    if (native.cpu_read_cr3() & (0xfffff000 as usize)) != selected:
        native.cpu_write_cr3(selected)
    gdt.set_kernel_stack(kernel_stack_top)
    return 0

pub fn process_kernel_cr3() -> usize:
    return KERNEL_CR3
