const PAGE_SIZE: usize = 4096 as usize
const PAGE_MASK: usize = 0xfffff000 as usize
const PRESENT_WRITE: usize = 3 as usize
const ARENA_START: usize = 0xc1000000 as usize
const ARENA_END: usize = 0xc1400000 as usize
const HEAP_END: usize = 0xc1200000 as usize
const SCHEDULER_START: usize = 0xc1200000 as usize
const ARENA_PDE: usize = 772 as usize
const SCRATCH_PDE: usize = 773 as usize
const SCRATCH_START: usize = 0xc1400000 as usize
const SCRATCH_SLOTS: usize = 4 as usize

static mut DIRECTORY_STORAGE: array[u8, 8191]
static mut IDENTITY_STORAGE: array[u8, 8191]
static mut ARENA_STORAGE: array[u8, 8191]
static mut SCRATCH_STORAGE: array[u8, 8191]
static mut DIRECTORY_ADDRESS: usize
static mut IDENTITY_ADDRESS: usize
static mut ARENA_TABLE_ADDRESS: usize
static mut SCRATCH_TABLE_ADDRESS: usize
static mut MAP_COUNT: usize
static mut UNMAP_COUNT: usize
static mut INVLPG_COUNT: usize
static mut MAP_HISTORY: array[usize, 1024]
static mut SCRATCH_MAPS: usize
static mut SCRATCH_UNMAPS: usize

fn align_page(address: usize) -> usize:
    return (address + (4095 as usize)) & PAGE_MASK

fn entry_address(table: usize, index: usize) -> ptr[u32]:
    return (table + (index << (2 as usize))) as ptr[u32]

fn read_entry(table: usize, index: usize) -> usize:
    return native.volatile_load32(entry_address(table, index)) as usize

fn write_entry(table: usize, index: usize, value: usize) -> int:
    native.volatile_store32(entry_address(table, index), value as u32)
    return 0

fn arena_valid(address: usize) -> bool:
    if address < ARENA_START:
        return false
    if address >= ARENA_END:
        return false
    return (address & (4095 as usize)) == (0 as usize)

pub fn paging_initialize() -> int:
    DIRECTORY_ADDRESS = align_page((&DIRECTORY_STORAGE) as usize)
    IDENTITY_ADDRESS = align_page((&IDENTITY_STORAGE) as usize)
    ARENA_TABLE_ADDRESS = align_page((&ARENA_STORAGE) as usize)
    SCRATCH_TABLE_ADDRESS = align_page((&SCRATCH_STORAGE) as usize)
    if (DIRECTORY_ADDRESS & (4095 as usize)) != (0 as usize):
        return 1
    if (IDENTITY_ADDRESS & (4095 as usize)) != (0 as usize):
        return 2
    if (ARENA_TABLE_ADDRESS & (4095 as usize)) != (0 as usize):
        return 3
    if DIRECTORY_ADDRESS >= (0x00400000 as usize):
        return 4
    if IDENTITY_ADDRESS >= (0x00400000 as usize):
        return 5
    if ARENA_TABLE_ADDRESS >= (0x00400000 as usize):
        return 6
    if SCRATCH_TABLE_ADDRESS >= (0x00400000 as usize):
        return 6
    let index: usize = 0 as usize
    while index < (1024 as usize):
        write_entry(DIRECTORY_ADDRESS, index, 0 as usize)
        write_entry(ARENA_TABLE_ADDRESS, index, 0 as usize)
        write_entry(IDENTITY_ADDRESS, index, (index << (12 as usize)) | PRESENT_WRITE)
        write_entry(SCRATCH_TABLE_ADDRESS, index, 0 as usize)
        index = index + (1 as usize)
    write_entry(DIRECTORY_ADDRESS, 0 as usize, IDENTITY_ADDRESS | PRESENT_WRITE)
    write_entry(DIRECTORY_ADDRESS, ARENA_PDE, ARENA_TABLE_ADDRESS | PRESENT_WRITE)
    write_entry(DIRECTORY_ADDRESS, SCRATCH_PDE, SCRATCH_TABLE_ADDRESS | PRESENT_WRITE)
    MAP_COUNT = 0 as usize
    UNMAP_COUNT = 0 as usize
    INVLPG_COUNT = 0 as usize
    SCRATCH_MAPS = 0 as usize
    SCRATCH_UNMAPS = 0 as usize
    native.cpu_write_cr3(DIRECTORY_ADDRESS)
    if (native.cpu_read_cr3() & PAGE_MASK) != DIRECTORY_ADDRESS:
        return 7
    let cr0: u32 = native.cpu_read_cr0()
    native.cpu_write_cr0(cr0 | (0x80000000 as u32))
    if (native.cpu_read_cr0() & (0x80000000 as u32)) == (0 as u32):
        return 8
    return 0

pub fn map_kernel_page(virtual_address: usize, physical_address: usize) -> int:
    if arena_valid(virtual_address) == false:
        return 1
    if physical_address == (0 as usize):
        return 2
    if (physical_address & (4095 as usize)) != (0 as usize):
        return 2
    let index: usize = (virtual_address - ARENA_START) >> (12 as usize)
    if (read_entry(ARENA_TABLE_ADDRESS, index) & (1 as usize)) != (0 as usize):
        return 3
    write_entry(ARENA_TABLE_ADDRESS, index, physical_address | PRESENT_WRITE)
    MAP_HISTORY[MAP_COUNT] = physical_address
    native.cpu_invlpg(virtual_address as ptr[u8])
    MAP_COUNT = MAP_COUNT + (1 as usize)
    INVLPG_COUNT = INVLPG_COUNT + (1 as usize)
    return 0

pub fn unmap_kernel_page(virtual_address: usize) -> usize:
    if arena_valid(virtual_address) == false:
        return 0 as usize
    let index: usize = (virtual_address - ARENA_START) >> (12 as usize)
    let entry: usize = read_entry(ARENA_TABLE_ADDRESS, index)
    if (entry & (1 as usize)) == (0 as usize):
        return 0 as usize
    write_entry(ARENA_TABLE_ADDRESS, index, 0 as usize)
    native.cpu_invlpg(virtual_address as ptr[u8])
    UNMAP_COUNT = UNMAP_COUNT + (1 as usize)
    INVLPG_COUNT = INVLPG_COUNT + (1 as usize)
    return entry & PAGE_MASK

pub fn is_kernel_page_mapped(virtual_address: usize) -> bool:
    if arena_valid(virtual_address) == false:
        return false
    let index: usize = (virtual_address - ARENA_START) >> (12 as usize)
    return (read_entry(ARENA_TABLE_ADDRESS, index) & (1 as usize)) != (0 as usize)

pub fn arena_start() -> usize:
    return ARENA_START

pub fn arena_end() -> usize:
    return ARENA_END

pub fn heap_end() -> usize:
    return HEAP_END

pub fn scheduler_start() -> usize:
    return SCHEDULER_START

pub fn directory_address() -> usize:
    return DIRECTORY_ADDRESS

pub fn scratch_map(slot: usize, physical_address: usize) -> usize:
    if slot >= SCRATCH_SLOTS:
        return 0 as usize
    if physical_address == (0 as usize):
        return 0 as usize
    if (physical_address & (4095 as usize)) != (0 as usize):
        return 0 as usize
    let address: usize = SCRATCH_START + (slot << (12 as usize))
    write_entry(SCRATCH_TABLE_ADDRESS, slot, physical_address | PRESENT_WRITE)
    native.cpu_invlpg(address as ptr[u8])
    SCRATCH_MAPS = SCRATCH_MAPS + (1 as usize)
    return address

pub fn scratch_unmap(slot: usize) -> int:
    if slot >= SCRATCH_SLOTS:
        return 1
    let address: usize = SCRATCH_START + (slot << (12 as usize))
    write_entry(SCRATCH_TABLE_ADDRESS, slot, 0 as usize)
    native.cpu_invlpg(address as ptr[u8])
    SCRATCH_UNMAPS = SCRATCH_UNMAPS + (1 as usize)
    return 0

pub fn arena_table_address() -> usize:
    return ARENA_TABLE_ADDRESS

pub fn map_count() -> usize:
    return MAP_COUNT

pub fn unmap_count() -> usize:
    return UNMAP_COUNT

pub fn invlpg_count() -> usize:
    return INVLPG_COUNT

pub fn mapped_frame(index: usize) -> usize:
    if index >= MAP_COUNT:
        return 0 as usize
    return MAP_HISTORY[index]

pub fn cr0_value() -> u32:
    return native.cpu_read_cr0()

pub fn cr3_value() -> usize:
    return native.cpu_read_cr3()

pub fn scratch_map_count() -> usize:
    return SCRATCH_MAPS

pub fn scratch_unmap_count() -> usize:
    return SCRATCH_UNMAPS
