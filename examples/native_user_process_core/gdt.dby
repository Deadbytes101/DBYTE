import "arch_x86.dby" as arch

struct SegmentDescriptor:
    low: u32
    high: u32

packed struct Tss32:
    previous: u32
    esp0: u32
    ss0: u32
    esp1: u32
    ss1: u32
    esp2: u32
    ss2: u32
    cr3: u32
    eip: u32
    eflags: u32
    eax: u32
    ecx: u32
    edx: u32
    ebx: u32
    esp: u32
    ebp: u32
    esi: u32
    edi: u32
    es: u32
    cs: u32
    ss: u32
    ds: u32
    fs: u32
    gs: u32
    ldt: u32
    trap_iomap: u32

static mut GDT: array[SegmentDescriptor, 6] = [SegmentDescriptor(0 as u32, 0 as u32), SegmentDescriptor(0x0000ffff as u32, 0x00cf9a00 as u32), SegmentDescriptor(0x0000ffff as u32, 0x00cf9200 as u32), SegmentDescriptor(0x0000ffff as u32, 0x00cffa00 as u32), SegmentDescriptor(0x0000ffff as u32, 0x00cff200 as u32), SegmentDescriptor(0 as u32, 0 as u32)]
static mut GDTR: arch.DescriptorTablePointer
static mut TSS: Tss32

fn install_tss_descriptor() -> int:
    let base: usize = (&TSS) as usize
    let limit: u32 = 103 as u32
    GDT[5 as usize].low = (limit & (0xffff as u32)) | (((base as u32) & (0xffff as u32)) << (16 as u32))
    GDT[5 as usize].high = (((base as u32) >> (16 as u32)) & (0xff as u32)) | (0x00008900 as u32) | (limit & (0x000f0000 as u32)) | ((base as u32) & (0xff000000 as u32))
    TSS.ss0 = 0x10 as u32
    TSS.esp0 = 0 as u32
    TSS.trap_iomap = (104 as u32) << (16 as u32)
    return 0

pub fn gdt_install() -> int:
    install_tss_descriptor()
    GDTR.limit = 47 as u16
    GDTR.base = (&GDT) as usize as u32
    native.cpu_lgdt((&GDTR) as usize)
    native.cpu_reload_segments(0x08 as u16, 0x10 as u16)
    native.cpu_ltr(0x28 as u16)
    return 0

pub fn set_kernel_stack(stack_top: usize) -> int:
    TSS.esp0 = stack_top as u32
    return 0

pub fn tss_address() -> usize:
    return (&TSS) as usize
