const PAGE_SIZE: usize = 4096 as usize
const PAGE_MASK: usize = 0xfffff000 as usize
const PRESENT_WRITE: usize = 3 as usize
const PROOF_ONE: usize = 0x00400000 as usize
const PROOF_TWO: usize = 0x00401000 as usize

static mut DIRECTORY_STORAGE: array[u8, 8191]
static mut IDENTITY_STORAGE: array[u8, 8191]
static mut FAULT_STORAGE: array[u8, 8191]
static mut DIRECTORY_ADDRESS: usize
static mut IDENTITY_ADDRESS: usize
static mut FAULT_ADDRESS: usize
static mut FAULT_FRAME: usize
static mut FAULT_ARMED: u32
static mut FAULT_SEEN: u32
static mut LAST_CR2: usize
static mut LAST_ERROR: u32

fn align_page(address: usize) -> usize:
    return (address + (4095 as usize)) & PAGE_MASK

fn write_entry(table: usize, index: usize, value: usize) -> int:
    native.volatile_store32((table + (index << (2 as usize))) as ptr[u32], value as u32)
    return 0

pub fn paging_initialize() -> int:
    DIRECTORY_ADDRESS = align_page((&DIRECTORY_STORAGE) as usize)
    IDENTITY_ADDRESS = align_page((&IDENTITY_STORAGE) as usize)
    FAULT_ADDRESS = align_page((&FAULT_STORAGE) as usize)
    if (DIRECTORY_ADDRESS & (4095 as usize)) != (0 as usize):
        return 1
    if (IDENTITY_ADDRESS & (4095 as usize)) != (0 as usize):
        return 2
    if (FAULT_ADDRESS & (4095 as usize)) != (0 as usize):
        return 3
    if DIRECTORY_ADDRESS >= (0x00400000 as usize):
        return 4
    if IDENTITY_ADDRESS >= (0x00400000 as usize):
        return 5
    if FAULT_ADDRESS >= (0x00400000 as usize):
        return 6
    let index: usize = 0 as usize
    while index < (1024 as usize):
        write_entry(DIRECTORY_ADDRESS, index, 0 as usize)
        write_entry(FAULT_ADDRESS, index, 0 as usize)
        write_entry(IDENTITY_ADDRESS, index, (index << (12 as usize)) | PRESENT_WRITE)
        index = index + (1 as usize)
    write_entry(DIRECTORY_ADDRESS, 0 as usize, IDENTITY_ADDRESS | PRESENT_WRITE)
    write_entry(DIRECTORY_ADDRESS, 1 as usize, FAULT_ADDRESS | PRESENT_WRITE)
    native.cpu_write_cr3(DIRECTORY_ADDRESS)
    if (native.cpu_read_cr3() & PAGE_MASK) != DIRECTORY_ADDRESS:
        return 7
    let cr0: u32 = native.cpu_read_cr0()
    native.cpu_write_cr0(cr0 | (0x80000000 as u32))
    if (native.cpu_read_cr0() & (0x80000000 as u32)) == (0 as u32):
        return 8
    return 0

pub fn arm(frame: usize) -> int:
    if frame == (0 as usize):
        return 1
    if (frame & (4095 as usize)) != (0 as usize):
        return 1
    FAULT_FRAME = frame
    FAULT_ARMED = 1 as u32
    FAULT_SEEN = 0 as u32
    return 0

pub fn resolve_fault(error_code: u32) -> int:
    let address: usize = native.cpu_read_cr2()
    LAST_CR2 = address
    LAST_ERROR = error_code
    if FAULT_ARMED != (1 as u32):
        return 1
    if address != PROOF_ONE:
        return 2
    if error_code != (2 as u32):
        return 3
    write_entry(FAULT_ADDRESS, 0 as usize, FAULT_FRAME | PRESENT_WRITE)
    native.cpu_invlpg(PROOF_ONE as ptr[u8])
    FAULT_ARMED = 0 as u32
    FAULT_SEEN = 1 as u32
    return 0

pub fn map_second(frame: usize) -> int:
    if frame == (0 as usize):
        return 1
    if (frame & (4095 as usize)) != (0 as usize):
        return 1
    write_entry(FAULT_ADDRESS, 1 as usize, frame | PRESENT_WRITE)
    native.cpu_invlpg(PROOF_TWO as ptr[u8])
    return 0

pub fn fault_seen() -> u32:
    return FAULT_SEEN

pub fn last_cr2() -> usize:
    return LAST_CR2

pub fn last_error() -> u32:
    return LAST_ERROR

pub fn directory_address() -> usize:
    return DIRECTORY_ADDRESS

pub fn identity_address() -> usize:
    return IDENTITY_ADDRESS

pub fn fault_table_address() -> usize:
    return FAULT_ADDRESS

pub fn cr0_value() -> u32:
    return native.cpu_read_cr0()

pub fn cr3_value() -> usize:
    return native.cpu_read_cr3()
