static mut BUFFER: array[u8, 64]

pub fn user_main() -> int:
    if user.syscall3(1 as u32, 1 as usize, 1 as usize, 1 as usize) != -3:
        return 7
    if user.syscall3(3 as u32, 1 as usize, 8 as usize, 1 as usize) != -3:
        return 8
    let start: str = "DBYRT64 WORKER START\r\n"
    if user.syscall3(1 as u32, 1 as usize, start, 22 as usize) != 22:
        return 10
    let path: str = "DATA.TXT"
    let fd: i32 = user.syscall3(3 as u32, path, 8 as usize, 1 as usize)
    if fd != 3:
        return 11
    if user.syscall3(4 as u32, fd as usize, 0x00400000 as usize, 64 as usize) != -3:
        return 9
    let count: i32 = user.syscall3(4 as u32, fd as usize, (&BUFFER[0]) as usize, 64 as usize)
    if count != 64:
        return 12
    if user.syscall1(5 as u32, fd as usize) != 0:
        return 13
    if BUFFER[0 as usize] != (0x44 as u8):
        return 14
    if BUFFER[1 as usize] != (0x42 as u8):
        return 14
    if BUFFER[2 as usize] != (0x59 as u8):
        return 14
    if BUFFER[3 as usize] != (0x54 as u8):
        return 14
    let ok: str = "DBYRT64 WORKER OK\r\n"
    if user.syscall3(1 as u32, 1 as usize, ok, 19 as usize) != 19:
        return 15
    return 0
