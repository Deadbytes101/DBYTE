import "arch_x86.dby" as arch
import "page_fault.dby" as page_fault
import "scheduler.dby" as scheduler
import "keyboard.dby" as keyboard

packed struct IdtEntry:
    offset_low: u16
    selector: u16
    zero: u8
    flags: u8
    offset_high: u16

static mut IDT: array[IdtEntry, 256]
static mut IDTR: arch.DescriptorTablePointer

fn set_gate(vector: usize, address: usize) -> int:
    IDT[vector].offset_low = (address & (0xffff as usize)) as u16
    IDT[vector].selector = 0x08 as u16
    IDT[vector].zero = 0 as u8
    IDT[vector].flags = 0x8e as u8
    IDT[vector].offset_high = (address >> (16 as usize)) as u16
    return 0

pub fn install() -> int:
    set_gate(14 as usize, interrupt_address(14, page_fault.page_fault))
    set_gate(32 as usize, interrupt_address(32, scheduler.irq0))
    set_gate(33 as usize, interrupt_address(33, keyboard.irq1))
    set_gate(129 as usize, interrupt_address(129, scheduler.block_trap))
    IDTR.limit = 2047 as u16
    IDTR.base = (&IDT) as usize as u32
    native.cpu_lidt((&IDTR) as usize)
    return 0
