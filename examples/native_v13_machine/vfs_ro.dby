import "dbfs1_ro.dby" as dbfs

pub struct VfsStat:
    inode_number: u32
    entry_type: u32
    size_bytes: u32
    direct_blocks: u32

static mut DBFS_STAT: dbfs.DbfsStat
static mut READY: u32
static mut LAST_ERROR: u32

pub fn initialize() -> int:
    READY = 0 as u32
    LAST_ERROR = 0 as u32
    let status: int = dbfs.initialize()
    if status != 0:
        LAST_ERROR = status as u32
        return status
    status = dbfs.mount()
    if status != 0:
        LAST_ERROR = status as u32
        return status
    READY = 1 as u32
    return 0

pub fn read(source_path: str, source_length: usize, destination: ptr[u8], capacity: usize, bytes_read: ptr[usize]) -> int:
    if READY == (0 as u32):
        return 6
    let status: int = dbfs.read(source_path, source_length, destination, capacity, bytes_read)
    LAST_ERROR = status as u32
    return status

pub fn read_at(source_path: str, source_length: usize, offset: usize, destination: ptr[u8], length: usize, bytes_read: ptr[usize]) -> int:
    if READY == (0 as u32):
        return 6
    let status: int = dbfs.read_at(source_path, source_length, offset, destination, length, bytes_read)
    LAST_ERROR = status as u32
    return status

pub fn read_inode_at(number: u32, offset: usize, destination: ptr[u8], length: usize, bytes_read: ptr[usize]) -> int:
    if READY == (0 as u32):
        return 6
    let status: int = dbfs.read_inode_at(number, offset, destination, length, bytes_read)
    LAST_ERROR = status as u32
    return status

pub fn stat(source_path: str, source_length: usize, output: ptr[VfsStat]) -> int:
    if READY == (0 as u32):
        return 6
    if output as usize == (0 as usize):
        return 1
    let status: int = dbfs.stat(source_path, source_length, &DBFS_STAT)
    if status != 0:
        LAST_ERROR = status as u32
        return status
    (*output).inode_number = DBFS_STAT.inode_number
    (*output).entry_type = DBFS_STAT.entry_type
    (*output).size_bytes = DBFS_STAT.size_bytes
    (*output).direct_blocks = DBFS_STAT.direct_blocks
    LAST_ERROR = 0 as u32
    return 0
pub fn ready() -> bool:
    return READY != (0 as u32)

pub fn last_error() -> u32:
    return LAST_ERROR

pub fn dbfs_reads() -> usize:
    return dbfs.read_count()
