const CR0_PE: u32 = 0x00000001 as u32
const CR0_PG: u32 = 0x80000000 as u32
const CR4_PAE: u32 = 0x00000020 as u32
const CPUID_APIC: u32 = 0x00000200 as u32
const CPUID_NX: u32 = 0x00100000 as u32
const CPUID_LM: u32 = 0x20000000 as u32
const EFER_LME: u64 = 0x0000000000000100 as u64
const EFER_LMA: u64 = 0x0000000000000400 as u64

static mut MAX_BASIC: u32
static mut MAX_EXTENDED: u32
static mut VENDOR_EBX: u32
static mut VENDOR_EDX: u32
static mut VENDOR_ECX: u32
static mut FEATURE1_ECX: u32
static mut FEATURE1_EDX: u32
static mut EXT1_EDX: u32
static mut CONTROL_CR0: u32
static mut CONTROL_CR3: usize
static mut CONTROL_CR4: u32
static mut CONTROL_EFER: u64

fn has_u32(value: u32, mask: u32) -> bool:
    return (value & mask) == mask

fn has_u64(value: u64, mask: u64) -> bool:
    return (value & mask) == mask
pub fn discover() -> int:
    MAX_BASIC = native.cpu_cpuid_eax(0 as u32, 0 as u32)
    VENDOR_EBX = native.cpu_cpuid_ebx(0 as u32, 0 as u32)
    VENDOR_EDX = native.cpu_cpuid_edx(0 as u32, 0 as u32)
    VENDOR_ECX = native.cpu_cpuid_ecx(0 as u32, 0 as u32)
    if MAX_BASIC < (1 as u32):
        return 1

    FEATURE1_ECX = native.cpu_cpuid_ecx(1 as u32, 0 as u32)
    FEATURE1_EDX = native.cpu_cpuid_edx(1 as u32, 0 as u32)
    if has_u32(FEATURE1_EDX, CPUID_APIC) == false:
        return 2

    MAX_EXTENDED = native.cpu_cpuid_eax(0x80000000 as u32, 0 as u32)
    if MAX_EXTENDED < (0x80000001 as u32):
        return 3
    EXT1_EDX = native.cpu_cpuid_edx(0x80000001 as u32, 0 as u32)
    if has_u32(EXT1_EDX, CPUID_LM) == false:
        return 4

    CONTROL_CR0 = native.cpu_read_cr0()
    CONTROL_CR3 = native.cpu_read_cr3()
    CONTROL_CR4 = native.cpu_read_cr4()
    if has_u32(CONTROL_CR0, CR0_PE | CR0_PG) == false:
        return 5
    if has_u32(CONTROL_CR4, CR4_PAE) == false:
        return 6
    if CONTROL_CR3 == (0 as usize):
        return 7
    if (CONTROL_CR3 & (0xFFF as usize)) != (0 as usize):
        return 8

    CONTROL_EFER = native.cpu_rdmsr(0xC0000080 as u32)
    if has_u64(CONTROL_EFER, EFER_LME) == false:
        return 9
    if has_u64(CONTROL_EFER, EFER_LMA) == false:
        return 10

    native.cpu_write_cr0(CONTROL_CR0)
    if native.cpu_read_cr0() != CONTROL_CR0:
        return 11
    native.cpu_write_cr3(CONTROL_CR3)
    if native.cpu_read_cr3() != CONTROL_CR3:
        return 12
    native.cpu_write_cr4(CONTROL_CR4)
    if native.cpu_read_cr4() != CONTROL_CR4:
        return 13
    native.cpu_wrmsr(0xC0000080 as u32, CONTROL_EFER)
    if native.cpu_rdmsr(0xC0000080 as u32) != CONTROL_EFER:
        return 14
    return 0

pub fn max_basic() -> u32:
    return MAX_BASIC
pub fn max_extended() -> u32:
    return MAX_EXTENDED

pub fn vendor_ebx() -> u32:
    return VENDOR_EBX

pub fn vendor_edx() -> u32:
    return VENDOR_EDX

pub fn vendor_ecx() -> u32:
    return VENDOR_ECX

pub fn feature1_ecx() -> u32:
    return FEATURE1_ECX

pub fn feature1_edx() -> u32:
    return FEATURE1_EDX

pub fn extended1_edx() -> u32:
    return EXT1_EDX

pub fn nx_supported() -> bool:
    return has_u32(EXT1_EDX, CPUID_NX)

pub fn cr0() -> u32:
    return CONTROL_CR0
pub fn cr3() -> usize:
    return CONTROL_CR3

pub fn cr4() -> u32:
    return CONTROL_CR4

pub fn efer() -> u64:
    return CONTROL_EFER
