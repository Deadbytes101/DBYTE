import "console.dby" as console
import "interrupts64.dby" as irq
import "paging64.dby" as paging

pub fn kernel_main() -> int:
    console.init()
    if irq.install() != 0:
        console.line("PAGING64 IRQ FAIL", 17 as usize)
        return 1
    if paging.initialize() != 0:
        console.line("PAGING64 INIT FAIL", 18 as usize)
        return 2
    let virtual: usize = paging.arena_start()
    if paging.map_page(virtual, paging.pml4_address() as u64, false, true) != 0:
        console.line("PAGING64 RO MAP FAIL", 20 as usize)
        return 3
    console.line("PAGING64 RO ARM", 15 as usize)
    native.volatile_store8(virtual as ptr[u8], 0xA5 as u8)
    console.line("PAGING64 RO MISSED", 18 as usize)
    return 4
