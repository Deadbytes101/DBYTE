static mut BUFFER: array[u8, 128]

fn expected_byte(index: usize) -> u8:
    return ((((index as u32) * (37 as u32)) + (0x41 as u32)) & (0xff as u32)) as u8

fn verify_payload() -> int:
    let index: usize = 0 as usize
    while index < (128 as usize):
        if BUFFER[index] != expected_byte(index):
            return 14
        index = index + (1 as usize)
    return 0

pub fn user_main() -> int:
    let message: str = "PERSIST USER START\r\n"
    if user.syscall3(1 as u32, 1 as usize, message, 20 as usize) != 20:
        return 10
    let path: str = "/HELLO.TXT"
    let fd: i32 = user.syscall3(3 as u32, path, 10 as usize, 1 as usize)
    if fd < 3:
        return 11
    let count: i32 = user.syscall3(4 as u32, fd as usize, (&BUFFER[0]) as usize, 128 as usize)
    if count != 128:
        return 12
    if user.syscall1(5 as u32, fd as usize) != 0:
        return 13
    if verify_payload() != 0:
        return 14
    let ok: str = "PERSIST USER OK\r\n"
    if user.syscall3(1 as u32, 1 as usize, ok, 17 as usize) != 17:
        return 15
    return 0
