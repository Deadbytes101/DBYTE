import "storage_ide.dby" as ro
import "acpi.dby" as acpi

const DATA_PORT: u16 = 0x01f0 as u16
const SECTOR_COUNT_PORT: u16 = 0x01f2 as u16
const LBA0_PORT: u16 = 0x01f3 as u16
const LBA1_PORT: u16 = 0x01f4 as u16
const LBA2_PORT: u16 = 0x01f5 as u16
const DRIVE_PORT: u16 = 0x01f6 as u16
const STATUS_PORT: u16 = 0x01f7 as u16
const COMMAND_PORT: u16 = 0x01f7 as u16
const ALT_STATUS_PORT: u16 = 0x03f6 as u16
const STATUS_ERR: u8 = 0x01 as u8
const STATUS_DRQ: u8 = 0x08 as u8
const STATUS_DF: u8 = 0x20 as u8
const STATUS_BSY: u8 = 0x80 as u8
const COMMAND_WRITE: u8 = 0x30 as u8
const COMMAND_FLUSH_CACHE: u8 = 0xe7 as u8
const DEVICE_MASTER_LBA: u8 = 0xe0 as u8
const FIXTURE_SECTORS: u32 = 0x00004000 as u32
const GUARD_LBA: u32 = 7 as u32
const SCRATCH_LBA: u32 = 8 as u32
const FS_GUARD_LBA: u32 = 63 as u32
const FS_FIRST_LBA: u32 = 85 as u32
const FS_SECOND_LBA: u32 = 69 as u32
const PROFILE_RAW: u32 = 1 as u32
const PROFILE_FS: u32 = 2 as u32
const TIMEOUT_PM_TICKS: u32 = 7159090 as u32
static mut GUARD: array[u16, 256]
static mut PREWRITE: array[u16, 256]
static mut ARMED: u32
static mut USED: u32
static mut PROFILE: u32
static mut FS_WRITE_STAGE: u32
static mut WORDS_WRITTEN: u32
static mut FLUSH_COUNT: u32
static mut LAST_ERROR: u32
fn pm_mask() -> u32:
    if acpi.pm_timer_width() == (32 as u32):
        return 0xffffffff as u32
    return 0x00ffffff as u32

fn pm_read() -> u32:
    return native.io_in32(acpi.pm_timer_port() as u16) & pm_mask()

fn pm_elapsed(start: u32, current: u32) -> u32:
    let mask: u32 = pm_mask()
    let first: u32 = start & mask
    let now: u32 = current & mask
    if now >= first:
        return now - first
    return (mask - first) + now + (1 as u32)

fn delay_400ns() -> int:
    native.io_in8(ALT_STATUS_PORT)
    native.io_in8(ALT_STATUS_PORT)
    native.io_in8(ALT_STATUS_PORT)
    native.io_in8(ALT_STATUS_PORT)
    return 0

fn wait_ready(require_drq: bool) -> int:
    let start: u32 = pm_read()
    while pm_elapsed(start, pm_read()) < TIMEOUT_PM_TICKS:
        let status: u8 = native.io_in8(STATUS_PORT)
        if (status & STATUS_BSY) == (0 as u8):
            if (status & STATUS_DF) != (0 as u8):
                return 6
            if (status & STATUS_ERR) != (0 as u8):
                return 7
            if require_drq == false:
                return 0
            if (status & STATUS_DRQ) != (0 as u8):
                return 0
    return 8

fn wait_complete() -> int:
    let start: u32 = pm_read()
    while pm_elapsed(start, pm_read()) < TIMEOUT_PM_TICKS:
        let status: u8 = native.io_in8(STATUS_PORT)
        if (status & STATUS_BSY) == (0 as u8):
            if (status & STATUS_DF) != (0 as u8):
                return 6
            if (status & STATUS_ERR) != (0 as u8):
                return 7
            if (status & STATUS_DRQ) == (0 as u8):
                return 0
    return 8
fn byte_at(buffer: ptr[u8], offset: usize) -> u8:
    return native.volatile_load8(((buffer as usize) + offset) as ptr[u8])

fn guard_magic(buffer: ptr[u8]) -> bool:
    if byte_at(buffer, 0 as usize) != (0x44 as u8):
        return false
    if byte_at(buffer, 1 as usize) != (0x42 as u8):
        return false
    if byte_at(buffer, 2 as usize) != (0x59 as u8):
        return false
    if byte_at(buffer, 3 as usize) != (0x54 as u8):
        return false
    if byte_at(buffer, 4 as usize) != (0x45 as u8):
        return false
    if byte_at(buffer, 5 as usize) != (0x56 as u8):
        return false
    if byte_at(buffer, 6 as usize) != (0x31 as u8):
        return false
    if byte_at(buffer, 7 as usize) != (0x33 as u8):
        return false
    if byte_at(buffer, 8 as usize) != (0x56 as u8):
        return false
    if byte_at(buffer, 9 as usize) != (0x57 as u8):
        return false
    if byte_at(buffer, 10 as usize) != (0x52 as u8):
        return false
    if byte_at(buffer, 11 as usize) != (0x49 as u8):
        return false
    if byte_at(buffer, 12 as usize) != (0x54 as u8):
        return false
    if byte_at(buffer, 13 as usize) != (0x45 as u8):
        return false
    if byte_at(buffer, 14 as usize) != (0x30 as u8):
        return false
    if byte_at(buffer, 15 as usize) != (0x31 as u8):
        return false
    return true

fn filesystem_guard_magic(buffer: ptr[u8]) -> bool:
    if byte_at(buffer, 0 as usize) != (0x44 as u8):
        return false
    if byte_at(buffer, 1 as usize) != (0x42 as u8):
        return false
    if byte_at(buffer, 2 as usize) != (0x59 as u8):
        return false
    if byte_at(buffer, 3 as usize) != (0x54 as u8):
        return false
    if byte_at(buffer, 4 as usize) != (0x45 as u8):
        return false
    if byte_at(buffer, 5 as usize) != (0x56 as u8):
        return false
    if byte_at(buffer, 6 as usize) != (0x31 as u8):
        return false
    if byte_at(buffer, 7 as usize) != (0x33 as u8):
        return false
    if byte_at(buffer, 8 as usize) != (0x44 as u8):
        return false
    if byte_at(buffer, 9 as usize) != (0x42 as u8):
        return false
    if byte_at(buffer, 10 as usize) != (0x46 as u8):
        return false
    if byte_at(buffer, 11 as usize) != (0x53 as u8):
        return false
    if byte_at(buffer, 12 as usize) != (0x52 as u8):
        return false
    if byte_at(buffer, 13 as usize) != (0x57 as u8):
        return false
    if byte_at(buffer, 14 as usize) != (0x30 as u8):
        return false
    if byte_at(buffer, 15 as usize) != (0x31 as u8):
        return false
    return true

fn guard_tail_zero(buffer: ptr[u8]) -> bool:
    let index: usize = 16 as usize
    while index < (512 as usize):
        if byte_at(buffer, index) != (0 as u8):
            return false
        index = index + (1 as usize)
    return true
fn sector_zero(buffer: ptr[u8]) -> bool:
    let index: usize = 0 as usize
    while index < (512 as usize):
        if byte_at(buffer, index) != (0 as u8):
            return false
        index = index + (1 as usize)
    return true

fn write_sector_internal(lba: u32, source: ptr[u8]) -> int:
    let ready: int = wait_ready(false)
    if ready != 0:
        return ready
    native.io_out8(SECTOR_COUNT_PORT, 1 as u8)
    native.io_out8(LBA0_PORT, (lba & (0xff as u32)) as u8)
    native.io_out8(LBA1_PORT, ((lba >> (8 as u32)) & (0xff as u32)) as u8)
    native.io_out8(LBA2_PORT, ((lba >> (16 as u32)) & (0xff as u32)) as u8)
    native.io_out8(DRIVE_PORT, DEVICE_MASTER_LBA | ((lba >> (24 as u32)) as u8))
    delay_400ns()
    native.io_out8(COMMAND_PORT, COMMAND_WRITE)
    let data_ready: int = wait_ready(true)
    if data_ready != 0:
        return data_ready
    let word: usize = 0 as usize
    while word < (256 as usize):
        native.io_out16(DATA_PORT, native.volatile_load16(((source as usize) + (word << (1 as usize))) as ptr[u16]))
        WORDS_WRITTEN = WORDS_WRITTEN + (1 as u32)
        word = word + (1 as usize)
    return wait_complete()

fn flush_internal() -> int:
    native.io_out8(COMMAND_PORT, COMMAND_FLUSH_CACHE)
    let status: int = wait_complete()
    if status == 0:
        FLUSH_COUNT = FLUSH_COUNT + (1 as u32)
    return status

pub fn arm_fixture() -> int:
    ARMED = 0 as u32
    USED = 0 as u32
    PROFILE = 0 as u32
    FS_WRITE_STAGE = 0 as u32
    WORDS_WRITTEN = 0 as u32
    FLUSH_COUNT = 0 as u32
    LAST_ERROR = 0 as u32
    if ro.sector_count() != FIXTURE_SECTORS:
        LAST_ERROR = 40 as u32
        return 40
    if ro.read_sector_into(GUARD_LBA, (&GUARD[0]) as usize as ptr[u8]) != 0:
        LAST_ERROR = 41 as u32
        return 41
    let guard_ptr: ptr[u8] = (&GUARD[0]) as usize as ptr[u8]
    if guard_magic(guard_ptr) == false:
        LAST_ERROR = 42 as u32
        return 42
    if guard_tail_zero(guard_ptr) == false:
        LAST_ERROR = 43 as u32
        return 43
    if ro.read_sector_into(SCRATCH_LBA, (&PREWRITE[0]) as usize as ptr[u8]) != 0:
        LAST_ERROR = 44 as u32
        return 44
    if sector_zero((&PREWRITE[0]) as usize as ptr[u8]) == false:
        LAST_ERROR = 45 as u32
        return 45
    PROFILE = PROFILE_RAW
    ARMED = 1 as u32
    return 0

pub fn write_and_flush(source: ptr[u8]) -> int:
    if ARMED == (0 as u32):
        LAST_ERROR = 46 as u32
        return 46
    if PROFILE != PROFILE_RAW:
        LAST_ERROR = 49 as u32
        return 49
    if USED != (0 as u32):
        LAST_ERROR = 47 as u32
        return 47
    if (source as usize) == (0 as usize):
        LAST_ERROR = 48 as u32
        return 48
    let status: int = write_sector_internal(SCRATCH_LBA, source)
    if status != 0:
        LAST_ERROR = status as u32
        return status
    status = flush_internal()
    if status != 0:
        LAST_ERROR = status as u32
        return status
    USED = 1 as u32
    LAST_ERROR = 0 as u32
    return 0

pub fn arm_filesystem_fixture() -> int:
    ARMED = 0 as u32
    USED = 0 as u32
    PROFILE = 0 as u32
    FS_WRITE_STAGE = 0 as u32
    WORDS_WRITTEN = 0 as u32
    FLUSH_COUNT = 0 as u32
    LAST_ERROR = 0 as u32
    if ro.sector_count() != FIXTURE_SECTORS:
        LAST_ERROR = 50 as u32
        return 50
    if ro.read_sector_into(FS_GUARD_LBA, (&GUARD[0]) as usize as ptr[u8]) != 0:
        LAST_ERROR = 51 as u32
        return 51
    let guard_ptr: ptr[u8] = (&GUARD[0]) as usize as ptr[u8]
    if filesystem_guard_magic(guard_ptr) == false:
        LAST_ERROR = 52 as u32
        return 52
    if guard_tail_zero(guard_ptr) == false:
        LAST_ERROR = 53 as u32
        return 53
    PROFILE = PROFILE_FS
    ARMED = 1 as u32
    return 0

pub fn write_filesystem_sector(lba: u32, source: ptr[u8]) -> int:
    if ARMED == (0 as u32):
        LAST_ERROR = 54 as u32
        return 54
    if PROFILE != PROFILE_FS:
        LAST_ERROR = 55 as u32
        return 55
    if (source as usize) == (0 as usize):
        LAST_ERROR = 57 as u32
        return 57
    let expected_lba: u32 = FS_FIRST_LBA
    if FS_WRITE_STAGE == (1 as u32):
        expected_lba = FS_SECOND_LBA
    else:
        if FS_WRITE_STAGE != (0 as u32):
            LAST_ERROR = 56 as u32
            return 56
    if lba != expected_lba:
        LAST_ERROR = 56 as u32
        return 56
    let status: int = write_sector_internal(lba, source)
    if status != 0:
        LAST_ERROR = status as u32
        return status
    FS_WRITE_STAGE = FS_WRITE_STAGE + (1 as u32)
    LAST_ERROR = 0 as u32
    return 0

pub fn flush_filesystem() -> int:
    if PROFILE != PROFILE_FS:
        LAST_ERROR = 62 as u32
        return 62
    if FS_WRITE_STAGE != (2 as u32):
        LAST_ERROR = 63 as u32
        return 63
    if USED != (0 as u32):
        LAST_ERROR = 65 as u32
        return 65
    let status: int = flush_internal()
    if status != 0:
        LAST_ERROR = status as u32
        return status
    USED = 1 as u32
    LAST_ERROR = 0 as u32
    return 0

pub fn armed() -> bool:
    return ARMED != (0 as u32)
pub fn used() -> bool:
    return USED != (0 as u32)
pub fn words_written() -> u32:
    return WORDS_WRITTEN
pub fn flush_count() -> u32:
    return FLUSH_COUNT
pub fn last_error() -> u32:
    return LAST_ERROR
pub fn scratch_lba() -> u32:
    return SCRATCH_LBA
