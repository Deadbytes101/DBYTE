pub struct InterruptFrame:
    eip: u32
    cs: u32
    eflags: u32

pub packed struct DescriptorTablePointer:
    limit: u16
    base: u32

pub fn out8(port: u16, value: u8) -> int:
    native.io_out8(port, value)
    return 0

pub fn in8(port: u16) -> u8:
    return native.io_in8(port)

pub fn cli() -> int:
    native.cpu_cli()
    return 0

pub fn hlt() -> int:
    native.cpu_hlt()
    return 0
