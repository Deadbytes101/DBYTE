import "boot.dby" as boot

static mut RESERVED_BITMAP: array[u8, 131072]
static mut OWNED_BITMAP: array[u8, 131072]
static mut NEXT_FRAME: usize
static mut IMAGE_START: usize
static mut IMAGE_END: usize
static mut STACK_START: usize
static mut STACK_END: usize
static mut ALLOCATIONS: usize
static mut RELEASES: usize

fn read32(address: usize) -> u32:
    return native.volatile_load32(address as ptr[u32])

fn bit_mask(frame: usize) -> u8:
    return (1 as u8) << ((frame & (7 as usize)) as u8)

fn reserved(frame: usize) -> bool:
    return (RESERVED_BITMAP[frame >> (3 as usize)] & bit_mask(frame)) != (0 as u8)

fn owned(frame: usize) -> bool:
    return (OWNED_BITMAP[frame >> (3 as usize)] & bit_mask(frame)) != (0 as u8)

fn set_reserved(frame: usize) -> int:
    let index: usize = frame >> (3 as usize)
    RESERVED_BITMAP[index] = RESERVED_BITMAP[index] | bit_mask(frame)
    return 0

fn clear_reserved(frame: usize) -> int:
    let index: usize = frame >> (3 as usize)
    RESERVED_BITMAP[index] = RESERVED_BITMAP[index] & (~bit_mask(frame))
    return 0

fn set_owned(frame: usize) -> int:
    let index: usize = frame >> (3 as usize)
    OWNED_BITMAP[index] = OWNED_BITMAP[index] | bit_mask(frame)
    return 0

fn clear_owned(frame: usize) -> int:
    let index: usize = frame >> (3 as usize)
    OWNED_BITMAP[index] = OWNED_BITMAP[index] & (~bit_mask(frame))
    return 0

fn clear_usable(base: usize, length: usize) -> int:
    if length == (0 as usize):
        return 0
    let end: usize = base + length
    if end < base:
        return 1
    let address: usize = (base + (4095 as usize)) & (0xfffff000 as usize)
    let limit: usize = end & (0xfffff000 as usize)
    while address < limit:
        clear_reserved(address >> (12 as usize))
        address = address + (4096 as usize)
    return 0

fn reserve_range(start: usize, end: usize) -> int:
    if end <= start:
        return 0
    let rounded: usize = end + (4095 as usize)
    if rounded < end:
        return 1
    let address: usize = start & (0xfffff000 as usize)
    let limit: usize = rounded & (0xfffff000 as usize)
    while address < limit:
        set_reserved(address >> (12 as usize))
        address = address + (4096 as usize)
    return 0

fn process_map(usable: bool) -> int:
    let cursor: usize = boot.mmap_address()
    let end: usize = cursor + (boot.mmap_length() as usize)
    while cursor < end:
        let payload: u32 = read32(cursor)
        let base: usize = read32(cursor + (4 as usize)) as usize
        let length: usize = read32(cursor + (12 as usize)) as usize
        let kind: u32 = read32(cursor + (20 as usize))
        if usable:
            if kind == (1 as u32):
                if clear_usable(base, length) != 0:
                    return 1
        else:
            if kind != (1 as u32):
                if reserve_range(base, base + length) != 0:
                    return 2
        cursor = cursor + (payload as usize) + (4 as usize)
    return 0

pub fn frames_initialize() -> int:
    let index: usize = 0 as usize
    while index < (131072 as usize):
        RESERVED_BITMAP[index] = 0xff as u8
        OWNED_BITMAP[index] = 0 as u8
        index = index + (1 as usize)
    if process_map(true) != 0:
        return 1
    if process_map(false) != 0:
        return 2
    IMAGE_START = native.kernel_image_start()
    IMAGE_END = native.kernel_image_end()
    STACK_START = native.bootstrap_stack_start()
    STACK_END = native.bootstrap_stack_end()
    if reserve_range(0 as usize, 0x00100000 as usize) != 0:
        return 3
    if reserve_range(IMAGE_START, IMAGE_END) != 0:
        return 4
    if reserve_range(STACK_START, STACK_END) != 0:
        return 5
    if reserve_range(boot.info_address(), boot.info_address() + (52 as usize)) != 0:
        return 6
    if reserve_range(boot.mmap_address(), boot.mmap_address() + (boot.mmap_length() as usize)) != 0:
        return 7
    NEXT_FRAME = (0x00100000 as usize) >> (12 as usize)
    ALLOCATIONS = 0 as usize
    RELEASES = 0 as usize
    return 0

pub fn allocate() -> usize:
    let frame: usize = NEXT_FRAME
    while frame < (1048576 as usize):
        if reserved(frame) == false:
            if owned(frame) == false:
                set_owned(frame)
                NEXT_FRAME = frame + (1 as usize)
                ALLOCATIONS = ALLOCATIONS + (1 as usize)
                return frame << (12 as usize)
        frame = frame + (1 as usize)
    return 0 as usize

pub fn release(address: usize) -> int:
    if address == (0 as usize):
        return 1
    if (address & (4095 as usize)) != (0 as usize):
        return 2
    let frame: usize = address >> (12 as usize)
    if frame >= (1048576 as usize):
        return 3
    if reserved(frame):
        return 4
    if owned(frame) == false:
        return 5
    clear_owned(frame)
    if frame < NEXT_FRAME:
        NEXT_FRAME = frame
    RELEASES = RELEASES + (1 as usize)
    return 0

pub fn is_owned(address: usize) -> bool:
    if (address & (4095 as usize)) != (0 as usize):
        return false
    return owned(address >> (12 as usize))

pub fn allocation_count() -> usize:
    return ALLOCATIONS

pub fn release_count() -> usize:
    return RELEASES

pub fn image_start() -> usize:
    return IMAGE_START

pub fn image_end() -> usize:
    return IMAGE_END

pub fn stack_start() -> usize:
    return STACK_START

pub fn stack_end() -> usize:
    return STACK_END
